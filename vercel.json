{
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/status"
    },
    {
      "source": "/status",
      "destination": "/api/status"
    },
    {
      "source": "/balance",
      "destination": "/api/balance"
    },
    {
      "source": "/api/status.json",
      "destination": "/api/status?format=json"
    },
    {
      "source": "/api/prefix-available",
      "destination": "/api/fulfill?op=prefix-available"
    },
    {
      "source": "/api/stamp",
      "destination": "/api/verify?op=stamp"
    },
    {
      "source": "/witness/v1/pins",
      "destination": "/api/pin?op=contract"
    },
    {
      "source": "/witness/v1/key",
      "destination": "/api/latest?op=contract-key"
    },
    {
      "source": "/witness/v1/statement",
      "destination": "/api/latest?op=contract-statement"
    },
    {
      "source": "/witness/v1/pins/:ns/receipt",
      "destination": "/api/latest?op=contract-receipt&ns=:ns"
    },
    {
      "source": "/witness/v1/pins/:ns",
      "destination": "/api/latest?op=contract-rows&ns=:ns"
    }
  ],
  "functions": {
    "api/pin.js": {
      "maxDuration": 30
    },
    "api/verify.js": {
      "maxDuration": 30
    },
    "api/stripe-webhook.js": {
      "maxDuration": 30
    },
    "api/fulfill.js": {
      "maxDuration": 30
    }
  }
}
