{
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/status"
    },
    {
      "source": "/status",
      "destination": "/api/status"
    },
    {
      "source": "/balance",
      "destination": "/api/balance"
    },
    {
      "source": "/api/status.json",
      "destination": "/api/status?format=json"
    },
    {
      "source": "/api/prefix-available",
      "destination": "/api/fulfill?op=prefix-available"
    },
    {
      "source": "/api/stamp",
      "destination": "/api/verify?op=stamp"
    },
    {
      "source": "/api/account/challenge",
      "destination": "/api/balance?op=account-challenge"
    },
    {
      "source": "/api/account/verify",
      "destination": "/api/balance?op=account-verify"
    },
    {
      "source": "/api/account/devices",
      "destination": "/api/balance?op=account-devices"
    }
  ],
  "functions": {
    "api/pin.js": {
      "maxDuration": 30
    },
    "api/verify.js": {
      "maxDuration": 30
    }
  }
}
