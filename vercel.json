{
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/status"
    },
    {
      "source": "/status",
      "destination": "/api/status"
    },
    {
      "source": "/balance",
      "destination": "/api/balance"
    },
    {
      "source": "/api/status.json",
      "destination": "/api/status?format=json"
    },
    {
      "source": "/api/prefix-available",
      "destination": "/api/fulfill?op=prefix-available"
    },
    {
      "source": "/.well-known/arcaeon-witness-key",
      "destination": "/api/verify?op=witness-key"
    },
    {
      "source": "/api/stamp",
      "destination": "/api/verify?op=stamp"
    }
  ],
  "functions": {
    "api/pin.js": {
      "maxDuration": 30
    },
    "api/verify.js": {
      "maxDuration": 30
    }
  }
}
